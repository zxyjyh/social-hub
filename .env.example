# ── Meta (Facebook / Instagram) ─────────────────────────────
# developers.facebook.com → 建 App → 设置 → 基本
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback
META_GRAPH_VERSION=v23.0

# ── Google Business Profile ─────────────────────────────────
# console.cloud.google.com → 凭据 → OAuth 客户端 ID
# 注意：新 GCP 项目配额默认 0 QPM，必须先通过
# support.google.com/business/contact/api_default
# 提交 "Application for Basic API Access" 并等人工审批
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── 澳觅内部 ────────────────────────────────────────────────
AOMI_AI_VIDEO_BASE_URL=
AOMI_API_TOKEN=

# ── 存储 ────────────────────────────────────────────────────
DATABASE_URL=
CREDENTIAL_ENCRYPTION_KEY=
